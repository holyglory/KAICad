<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:kicad:automation:knowledge:1"
           xmlns="urn:kicad:automation:knowledge:1" elementFormDefault="qualified">
  <xs:simpleType name="identity"><xs:restriction base="xs:string">
    <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="strength"><xs:restriction base="xs:string">
    <xs:enumeration value="Information"/><xs:enumeration value="Preference"/><xs:enumeration value="Requirement"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="verification"><xs:restriction base="xs:string">
    <xs:enumeration value="Unknown"/><xs:enumeration value="Unverified"/><xs:enumeration value="Verified"/>
    <xs:enumeration value="Violated"/><xs:enumeration value="Unsupported"/><xs:enumeration value="Conflicting"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="guidance">
    <xs:sequence>
      <xs:element name="text" type="xs:string"/>
      <xs:element name="exception-rationale" type="xs:string" minOccurs="0"/>
      <xs:element name="quantity" minOccurs="0"><xs:complexType>
        <xs:sequence><xs:element name="tolerance" minOccurs="0"><xs:complexType>
          <xs:attribute name="kind" use="required"><xs:simpleType><xs:restriction base="xs:string">
            <xs:enumeration value="Absolute"/><xs:enumeration value="Percent"/>
          </xs:restriction></xs:simpleType></xs:attribute>
          <xs:attribute name="minus" type="xs:decimal" use="required"/>
          <xs:attribute name="plus" type="xs:decimal" use="required"/>
        </xs:complexType></xs:element></xs:sequence>
        <xs:attribute name="kind" use="required"><xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="Unclassified"/><xs:enumeration value="Nominal"/>
          <xs:enumeration value="OperatingLimit"/><xs:enumeration value="AbsoluteMaximum"/>
          <xs:enumeration value="Measurement"/>
        </xs:restriction></xs:simpleType></xs:attribute>
        <xs:attribute name="unit" type="xs:string" use="required"/>
        <xs:attribute name="nominal" type="xs:decimal"/>
        <xs:attribute name="minimum" type="xs:decimal"/>
        <xs:attribute name="maximum" type="xs:decimal"/>
        <xs:attribute name="unknown-reason" type="xs:string"/>
      </xs:complexType></xs:element>
      <xs:element name="source" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
        <xs:attribute name="document" type="xs:string" use="required"/>
        <xs:attribute name="revision" type="xs:string" use="required"/>
        <xs:attribute name="page" type="xs:positiveInteger"/>
        <xs:attribute name="table" type="xs:string"/>
        <xs:attribute name="part-variant" type="xs:string"/>
      </xs:complexType></xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="identity" use="required"/>
    <xs:attribute name="key" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="strength" type="strength" use="required"/>
    <xs:attribute name="applicability" type="xs:string" use="required"/>
    <xs:attribute name="verification" type="verification" use="required"/>
    <xs:attribute name="replaces" type="identity"/>
  </xs:complexType>
  <xs:element name="guidance" type="guidance"/>
  <xs:element name="component-library"><xs:complexType><xs:sequence>
    <xs:element name="class" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
      <xs:element name="guidance" type="guidance" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
      <xs:attribute name="id" type="identity" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="base" type="identity"/>
    </xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="id" type="identity" use="required"/>
    <xs:attribute name="revision" type="xs:string" use="required"/>
    <xs:attribute name="version" type="xs:positiveInteger" use="required" fixed="1"/>
  </xs:complexType></xs:element>
  <xs:element name="component-binding"><xs:complexType><xs:sequence>
    <xs:element name="guidance" type="guidance" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence>
    <xs:attribute name="component" type="identity" use="required"/>
    <xs:attribute name="library" type="identity" use="required"/>
    <xs:attribute name="library-revision" type="xs:string" use="required"/>
    <xs:attribute name="class" type="identity" use="required"/>
    <xs:attribute name="version" type="xs:positiveInteger" use="required" fixed="1"/>
  </xs:complexType></xs:element>
</xs:schema>
