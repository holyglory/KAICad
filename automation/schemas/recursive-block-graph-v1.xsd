<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:kicad:automation:recursive-block-graph:1"
           xmlns="urn:kicad:automation:recursive-block-graph:1"
           xmlns:h="urn:kicad:automation:requirement-history:1"
           xmlns:c="urn:kicad:automation:connection-archive:1"
           xmlns:d="urn:kicad:automation:block-definition:1" elementFormDefault="qualified">
  <xs:import namespace="urn:kicad:automation:requirement-history:1"/>
  <xs:import namespace="urn:kicad:automation:connection-archive:1"/>
  <xs:import namespace="urn:kicad:automation:block-definition:1"/>
  <xs:complexType name="selection">
    <xs:attribute name="block" type="h:identity" use="required"/>
    <xs:attribute name="state" type="h:identity" use="required"/>
    <xs:attribute name="revision" type="h:identity" use="required"/>
  </xs:complexType>
  <xs:simpleType name="annotation-role"><xs:restriction base="xs:string">
    <xs:enumeration value="Comment"/><xs:enumeration value="Instruction"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="implementation-change-kind"><xs:restriction base="xs:string">
    <xs:enumeration value="Rename"/><xs:enumeration value="Archive"/><xs:enumeration value="Restore"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="annotation-target"><xs:restriction base="xs:string">
    <xs:enumeration value="Canvas"/><xs:enumeration value="Block"/><xs:enumeration value="Connection"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="annotation-point">
    <xs:attribute name="x" type="xs:decimal" use="required"/><xs:attribute name="y" type="xs:decimal" use="required"/>
  </xs:complexType>
  <xs:complexType name="origin"><xs:sequence>
    <xs:element name="summary" type="xs:string"/>
    <xs:element name="source" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
      <xs:attribute name="document" type="xs:string" use="required"/>
      <xs:attribute name="revision" type="xs:string" use="required"/>
      <xs:attribute name="page" type="xs:positiveInteger"/>
      <xs:attribute name="table" type="xs:string"/>
      <xs:attribute name="part-variant" type="xs:string"/>
    </xs:complexType></xs:element>
    <xs:element name="input" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
      <xs:attribute name="ref" type="h:identity" use="required"/>
    </xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="actor-kind" type="h:actor" use="required"/>
    <xs:attribute name="actor" type="xs:string" use="required"/>
    <xs:attribute name="at" type="xs:dateTime" use="required"/>
  </xs:complexType>
  <xs:element name="recursive-block-graph"><xs:complexType><xs:sequence>
    <xs:element name="selected-root" type="selection"/>
    <xs:element name="states"><xs:complexType><xs:sequence>
      <xs:element name="state" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="forked-from" type="selection" minOccurs="0"/>
      </xs:sequence>
        <xs:attribute name="id" type="h:identity" use="required"/>
        <xs:attribute name="block" type="h:identity" use="required"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="head" type="h:identity" use="required"/>
        <xs:attribute name="archived" type="xs:boolean"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="revisions"><xs:complexType><xs:sequence>
      <xs:element name="revision" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="origin" type="origin"/>
        <xs:element name="children"><xs:complexType><xs:sequence>
          <xs:element name="child" type="selection" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType></xs:element>
        <xs:element name="restored-from" type="selection" minOccurs="0"/>
        <xs:element name="local-diagram" minOccurs="0"><xs:complexType><xs:sequence>
          <xs:element name="interfaces"><xs:complexType><xs:sequence>
            <xs:element name="interface" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
              <xs:element name="intent" type="xs:string"/>
            </xs:sequence><xs:attribute name="id" type="h:identity" use="required"/>
              <xs:attribute name="name" type="xs:string" use="required"/>
            </xs:complexType></xs:element>
          </xs:sequence></xs:complexType></xs:element>
          <xs:element name="connections"><xs:complexType><xs:sequence>
            <xs:element name="connection" type="c:selection" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence></xs:complexType></xs:element>
          <xs:element name="annotations" minOccurs="0"><xs:complexType><xs:sequence>
            <xs:element name="annotation" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
              <xs:element name="origin" type="origin"/>
              <xs:element name="text" type="xs:string"/>
              <xs:element name="target"><xs:complexType><xs:sequence>
                <xs:element name="unresolved-reason" type="xs:string" minOccurs="0"/>
              </xs:sequence><xs:attribute name="kind" type="annotation-target" use="required"/>
                <xs:attribute name="ref" type="h:identity"/>
              </xs:complexType></xs:element>
              <xs:element name="position" type="annotation-point" minOccurs="0"/>
              <xs:element name="strokes"><xs:complexType><xs:sequence>
                <xs:element name="stroke" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
                  <xs:element name="point" type="annotation-point" minOccurs="2" maxOccurs="unbounded"/>
                </xs:sequence></xs:complexType></xs:element>
              </xs:sequence></xs:complexType></xs:element>
            </xs:sequence><xs:attribute name="id" type="h:identity" use="required"/>
              <xs:attribute name="role" type="annotation-role" use="required"/>
              <xs:attribute name="units" type="xs:string" use="required" fixed="diagram-unit"/>
            </xs:complexType></xs:element>
          </xs:sequence></xs:complexType></xs:element>
        </xs:sequence></xs:complexType></xs:element>
        <xs:element ref="d:definition" minOccurs="0"/>
      </xs:sequence>
        <xs:attribute name="id" type="h:identity" use="required"/>
        <xs:attribute name="block" type="h:identity" use="required"/>
        <xs:attribute name="state" type="h:identity" use="required"/>
        <xs:attribute name="parent" type="h:identity"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="requirements" type="h:identity" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="requirement-histories"><xs:complexType><xs:sequence>
      <xs:element ref="h:requirement-history" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="connection-archives" minOccurs="0"><xs:complexType><xs:sequence>
      <xs:element ref="c:connection-archive" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="implementation-changes" minOccurs="0"><xs:complexType><xs:sequence>
      <xs:element name="change" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="origin" type="origin"/>
      </xs:sequence>
        <xs:attribute name="id" type="h:identity" use="required"/><xs:attribute name="state" type="h:identity" use="required"/>
        <xs:attribute name="kind" type="implementation-change-kind" use="required"/>
        <xs:attribute name="before-name" type="xs:string" use="required"/><xs:attribute name="after-name" type="xs:string" use="required"/>
        <xs:attribute name="before-archived" type="xs:boolean" use="required"/><xs:attribute name="after-archived" type="xs:boolean" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="version" type="xs:positiveInteger" use="required" fixed="1"/>
    <xs:attribute name="document" type="h:identity" use="required"/>
  </xs:complexType></xs:element>
</xs:schema>
