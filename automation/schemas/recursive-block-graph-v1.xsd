<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:kicad:automation:recursive-block-graph:1"
           xmlns="urn:kicad:automation:recursive-block-graph:1"
           xmlns:h="urn:kicad:automation:requirement-history:1" elementFormDefault="qualified">
  <xs:import namespace="urn:kicad:automation:requirement-history:1"/>
  <xs:complexType name="selection">
    <xs:attribute name="block" type="h:identity" use="required"/>
    <xs:attribute name="state" type="h:identity" use="required"/>
    <xs:attribute name="revision" type="h:identity" use="required"/>
  </xs:complexType>
  <xs:complexType name="origin"><xs:sequence>
    <xs:element name="summary" type="xs:string"/>
    <xs:element name="source" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
      <xs:attribute name="document" type="xs:string" use="required"/>
      <xs:attribute name="revision" type="xs:string" use="required"/>
      <xs:attribute name="page" type="xs:positiveInteger"/>
      <xs:attribute name="table" type="xs:string"/>
      <xs:attribute name="part-variant" type="xs:string"/>
    </xs:complexType></xs:element>
    <xs:element name="input" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
      <xs:attribute name="ref" type="h:identity" use="required"/>
    </xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="actor-kind" type="h:actor" use="required"/>
    <xs:attribute name="actor" type="xs:string" use="required"/>
    <xs:attribute name="at" type="xs:dateTime" use="required"/>
  </xs:complexType>
  <xs:element name="recursive-block-graph"><xs:complexType><xs:sequence>
    <xs:element name="selected-root" type="selection"/>
    <xs:element name="states"><xs:complexType><xs:sequence>
      <xs:element name="state" minOccurs="1" maxOccurs="unbounded"><xs:complexType>
        <xs:attribute name="id" type="h:identity" use="required"/>
        <xs:attribute name="block" type="h:identity" use="required"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="head" type="h:identity" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="revisions"><xs:complexType><xs:sequence>
      <xs:element name="revision" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="origin" type="origin"/>
        <xs:element name="children"><xs:complexType><xs:sequence>
          <xs:element name="child" type="selection" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence></xs:complexType></xs:element>
      </xs:sequence>
        <xs:attribute name="id" type="h:identity" use="required"/>
        <xs:attribute name="block" type="h:identity" use="required"/>
        <xs:attribute name="state" type="h:identity" use="required"/>
        <xs:attribute name="parent" type="h:identity"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="requirements" type="h:identity" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="requirement-histories"><xs:complexType><xs:sequence>
      <xs:element ref="h:requirement-history" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence></xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="version" type="xs:positiveInteger" use="required" fixed="1"/>
    <xs:attribute name="document" type="h:identity" use="required"/>
  </xs:complexType></xs:element>
</xs:schema>
