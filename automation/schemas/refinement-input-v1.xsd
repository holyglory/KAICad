<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="urn:kicad:automation:refinement-input:1"
  xmlns="urn:kicad:automation:refinement-input:1"
  xmlns:h="urn:kicad:automation:requirement-history:1" elementFormDefault="qualified">
  <xs:import namespace="urn:kicad:automation:requirement-history:1"/>
  <xs:simpleType name="sha256"><xs:restriction base="xs:string"><xs:length value="64"/><xs:pattern value="[0-9a-f]{64}"/></xs:restriction></xs:simpleType>
  <xs:complexType name="selection">
    <xs:attribute name="id" type="h:identity" use="required"/>
    <xs:attribute name="state" type="h:identity" use="required"/>
    <xs:attribute name="revision" type="h:identity" use="required"/>
  </xs:complexType>
  <xs:complexType name="source">
    <xs:attribute name="document" type="xs:string" use="required"/><xs:attribute name="revision" type="xs:string" use="required"/>
    <xs:attribute name="page" type="xs:positiveInteger"/><xs:attribute name="table" type="xs:string"/>
    <xs:attribute name="part-variant" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="origin"><xs:sequence>
    <xs:element name="summary" type="xs:string"/><xs:element name="source" type="source" minOccurs="0" maxOccurs="unbounded"/>
    <xs:element name="input" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
      <xs:attribute name="ref" type="h:identity" use="required"/>
    </xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="actor-kind" type="h:actor" use="required"/><xs:attribute name="actor" type="xs:string" use="required"/>
    <xs:attribute name="at" type="xs:dateTime" use="required"/>
  </xs:complexType>
  <xs:element name="refinement-input"><xs:complexType><xs:sequence>
    <xs:element name="origin" type="origin"/><xs:element name="prompt" type="xs:string"/>
    <xs:element name="block-path"><xs:complexType><xs:sequence>
      <xs:element name="block" type="selection" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="connection-path"><xs:complexType><xs:sequence>
      <xs:element name="connection" type="selection" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="attachments"><xs:complexType><xs:sequence>
      <xs:element name="attachment" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="original-name" type="xs:string"/><xs:element name="source" type="source" minOccurs="0"/>
      </xs:sequence>
        <xs:attribute name="id" type="h:identity" use="required"/><xs:attribute name="asset" type="xs:string" use="required"/>
        <xs:attribute name="sha256" type="sha256" use="required"/><xs:attribute name="bytes" type="xs:nonNegativeInteger" use="required"/>
        <xs:attribute name="media-type" type="xs:string" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
  </xs:sequence>
    <xs:attribute name="version" type="xs:positiveInteger" use="required" fixed="1"/>
    <xs:attribute name="id" type="h:identity" use="required"/><xs:attribute name="document" type="h:identity" use="required"/>
    <xs:attribute name="source-sha256" type="sha256" use="required"/>
  </xs:complexType></xs:element>
</xs:schema>
