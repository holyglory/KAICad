<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:kicad:automation:structure:1"
           xmlns="urn:kicad:automation:structure:1" elementFormDefault="qualified">
  <xs:simpleType name="identity"><xs:restriction base="xs:string">
    <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="kind"><xs:restriction base="xs:string">
    <xs:enumeration value="Unspecified"/><xs:enumeration value="Power"/><xs:enumeration value="Data"/>
    <xs:enumeration value="Control"/><xs:enumeration value="Analog"/><xs:enumeration value="Mechanical"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="role"><xs:restriction base="xs:string">
    <xs:enumeration value="Intent"/><xs:enumeration value="Interpretation"/><xs:enumeration value="Realization"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="strength"><xs:restriction base="xs:string">
    <xs:enumeration value="Requirement"/><xs:enumeration value="Preference"/><xs:enumeration value="Information"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="reference"><xs:attribute name="ref" type="identity" use="required"/></xs:complexType>
  <xs:simpleType name="net-change"><xs:restriction base="xs:string">
    <xs:enumeration value="Split"/><xs:enumeration value="Merged"/>
    <xs:enumeration value="Removed"/><xs:enumeration value="Reidentified"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="pin">
    <xs:attribute name="component" type="identity" use="required"/>
    <xs:attribute name="number" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:simpleType name="component-reference-slot"><xs:restriction base="xs:string">
    <xs:enumeration value="StatementTarget"/><xs:enumeration value="FirstPin"/>
    <xs:enumeration value="SecondPin"/><xs:enumeration value="BlockRealization"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="component-reference-change"><xs:restriction base="xs:string">
    <xs:enumeration value="Removed"/><xs:enumeration value="Reidentified"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="component-reference-target">
    <xs:attribute name="component" type="identity" use="required"/>
    <xs:attribute name="pin" type="xs:string"/>
  </xs:complexType>
  <xs:element name="structure"><xs:complexType><xs:sequence>
    <xs:element name="blocks"><xs:complexType><xs:sequence>
      <xs:element name="block" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="component" type="reference" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence><xs:attribute name="id" type="identity" use="required"/>
        <xs:attribute name="name" type="xs:string" use="required"/><xs:attribute name="parent" type="identity"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="ports"><xs:complexType><xs:sequence>
      <xs:element name="port" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
        <xs:attribute name="id" type="identity" use="required"/><xs:attribute name="block" type="identity" use="required"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="connections"><xs:complexType><xs:sequence>
      <xs:element name="connection" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="description" type="xs:string"/>
        <xs:element name="net" type="reference" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence><xs:attribute name="id" type="identity" use="required"/>
        <xs:attribute name="first-port" type="identity" use="required"/>
        <xs:attribute name="second-port" type="identity" use="required"/><xs:attribute name="kind" type="kind" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="statements"><xs:complexType><xs:sequence>
      <xs:element name="statement" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="text" type="xs:string"/>
        <xs:element name="pin-connection" minOccurs="0"><xs:complexType><xs:sequence>
          <xs:element name="first" type="pin"/><xs:element name="second" type="pin"/>
        </xs:sequence></xs:complexType></xs:element>
        <xs:element name="derived-from" type="reference" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="source" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
          <xs:attribute name="document" type="xs:string" use="required"/>
          <xs:attribute name="revision" type="xs:string" use="required"/>
          <xs:attribute name="page" type="xs:positiveInteger"/><xs:attribute name="table" type="xs:string"/>
          <xs:attribute name="part-variant" type="xs:string"/>
        </xs:complexType></xs:element>
      </xs:sequence><xs:attribute name="id" type="identity" use="required"/>
        <xs:attribute name="target" type="identity" use="required"/><xs:attribute name="role" type="role" use="required"/>
        <xs:attribute name="strength" type="strength"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="unresolved-net-bindings" minOccurs="0"><xs:complexType><xs:sequence>
      <xs:element name="binding" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="reason" type="xs:string"/>
        <xs:element name="candidate" type="reference" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence><xs:attribute name="owner" type="identity" use="required"/>
        <xs:attribute name="former-net" type="identity" use="required"/>
        <xs:attribute name="change" type="net-change" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="unresolved-component-references" minOccurs="0"><xs:complexType><xs:sequence>
      <xs:element name="reference" minOccurs="1" maxOccurs="unbounded"><xs:complexType><xs:sequence>
        <xs:element name="former" type="component-reference-target"/>
        <xs:element name="reason" type="xs:string"/>
        <xs:element name="candidate" type="component-reference-target" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence><xs:attribute name="owner" type="identity" use="required"/>
        <xs:attribute name="slot" type="component-reference-slot" use="required"/>
        <xs:attribute name="change" type="component-reference-change" use="required"/>
      </xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
  </xs:sequence><xs:attribute name="version" type="xs:positiveInteger" use="required" fixed="1"/>
    <xs:attribute name="id" type="identity" use="required"/>
  </xs:complexType></xs:element>
</xs:schema>
